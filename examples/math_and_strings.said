// -------------------------------------------------------------
// SaidLang: Full Conversational Math, Strings & Types Demo
// -------------------------------------------------------------

say === 1. Variable Declarations in All Types ===
save user_name as Noman as string
save user_age as 21 as integer
save hourly_rate as 45.50 as float
save is_available as yes as boolean
save skills as ["Python", "PHP", "Node.js"] as list
save profile as {"role": "Engineer", "level": "Senior"} as dict

say User: @user_name | Age: @user_age | Rate: $@hourly_rate | Active: @is_available
say Skills: @skills
say Profile: @profile

say \n=== 2. Conversational Math & Calculations ===
calculate 15 percent of 500 into discount_price
say 15 percent of 500 is: @discount_price

add 100 and 50 into sum_total
subtract 30 from 100 into diff_total
multiply 8 by 9 into product_total
divide 100 by 4 into div_total

say 100 + 50 = @sum_total
say 100 - 30 = @diff_total
say 8 * 9 = @product_total
say 100 / 4 = @div_total

find square root of 144 into root_val
say Square root of 144 is: @root_val

find power of 2 to 8 into power_val
say 2 to the power of 8 is: @power_val

round 49.8765 to 2 decimals into rounded_val
say 49.8765 rounded to 2 decimals is: @rounded_val

save exam_scores as [85, 92, 78, 96, 88] as list
find highest in @exam_scores into top_score
find lowest in @exam_scores into min_score
find average of @exam_scores into avg_score

say Scores: @exam_scores
say Highest: @top_score | Lowest: @min_score | Average: @avg_score

say \n=== 3. Conversational String & Text Operations ===
save raw_input as "  Hello SaidLang World  " as string

trim spaces from @raw_input into clean_text
change @clean_text to uppercase into upper_text
change @clean_text to lowercase into lower_text
count characters in @clean_text into char_count
count words in @clean_text into word_count
replace "World" with "Universe" in @clean_text into replaced_text

say Trimmed: @clean_text
say Uppercase: @upper_text
say Lowercase: @lower_text
say Total Characters: @char_count
say Total Words: @word_count
say Replaced: @replaced_text

check if @clean_text contains "SaidLang" then say Found SaidLang keyword in text! else say Not found
check if @clean_text starts with "Hello" then say Starts with Hello! else say Does not start with Hello
