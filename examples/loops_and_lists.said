// -------------------------------------------------------------
// Loops and Lists in SaidLang
// -------------------------------------------------------------

show "=== Repeating 3 times ==="
repeat 3 times:
    show "This is very simple!"

show "\n=== Counting from 1 to 5 ==="
count from 1 to 5 as number:
    show "Number: " + str(number)

show "\n=== Working with Lists ==="
create list fruits
add "Apple" to fruits
add "Mango" to fruits
add "Banana" to fruits

show "Fruits list: " + str(fruits)

for each fruit in fruits:
    show "I love eating " + fruit
