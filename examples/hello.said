// -------------------------------------------------------------
// Welcome to SaidLang - Hello World Example
// -------------------------------------------------------------

say "Hello, welcome to SaidLang!"

set name to "Said"
set age to 21

say "My name is " + name + " and I am " + str(age) + " years old."

if age is greater than or equal to 18:
    show "You are an adult!"
otherwise:
    show "You are a minor!"
