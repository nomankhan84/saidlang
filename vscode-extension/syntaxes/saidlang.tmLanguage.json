{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SaidLang",
  "scopeName": "source.said",
  "patterns": [
    { "include": "#comments" },
    { "include": "#at_variables" },
    { "include": "#possessive_variables" },
    { "include": "#strings" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#math_keywords" },
    { "include": "#string_keywords" },
    { "include": "#control_keywords" },
    { "include": "#action_keywords" },
    { "include": "#natural_operators" },
    { "include": "#function_definition" },
    { "include": "#function_calls" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.said",
          "match": "(//|#|note:).*$"
        },
        {
          "name": "comment.block.said",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "at_variables": {
      "patterns": [
        {
          "name": "variable.other.readwrite.said",
          "match": "@[a-zA-Z_][\\w]*(?:['’]s\\s+[a-zA-Z_]\\w*|['’]s)?"
        }
      ]
    },
    "possessive_variables": {
      "patterns": [
        {
          "name": "variable.other.readwrite.said",
          "match": "\\b[a-zA-Z_][\\w]*['’]s\\s+[a-zA-Z_]\\w*\\b"
        },
        {
          "name": "variable.other.readwrite.said",
          "match": "\\b[a-zA-Z_][\\w]*['’]s\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.said",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.said",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.said",
          "begin": "(?<![a-zA-Z0-9_])'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.said",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.said",
          "match": "\\b(string|text|str|integer|int|number|float|decimal|boolean|bool|list|array|dict|dictionary|object|tuple|set)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.said",
          "match": "\\b(true|false|yes|no)\\b"
        },
        {
          "name": "constant.language.null.said",
          "match": "\\b(nothing|null|none)\\b"
        }
      ]
    },
    "math_keywords": {
      "patterns": [
        {
          "name": "keyword.other.math.said",
          "match": "\\b(calculate|percent of|add|subtract|multiply|divide|find square root of|find power of|round|decimals|highest in|lowest in|average of|min|max|highest|lowest)\\b"
        }
      ]
    },
    "string_keywords": {
      "patterns": [
        {
          "name": "keyword.other.string.said",
          "match": "\\b(change|convert|to uppercase|to lowercase|trim spaces from|count characters in|count words in|replace|with|check if|starts with|ends with|contains)\\b"
        }
      ]
    },
    "control_keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.said",
          "match": "\\b(if|then|otherwise if|else if|or if|otherwise|else|unless)\\b"
        },
        {
          "name": "keyword.control.loop.said",
          "match": "\\b(repeat|while|times|with|count from|step|as|for each|in|stop loop|break|skip to next|continue|do|done|finish)\\b"
        },
        {
          "name": "keyword.control.trycatch.said",
          "match": "\\b(attempt|try|on error|catch)\\b"
        },
        {
          "name": "keyword.control.flow.said",
          "match": "\\b(give back|return|wait)\\b"
        }
      ]
    },
    "action_keywords": {
      "patterns": [
        {
          "name": "keyword.other.said",
          "match": "\\b(save|store|set|make|let|remember|to|be|as|in|into|from|and|by)\\b"
        },
        {
          "name": "entity.name.function.io.said",
          "match": "\\b(show|say|display|print|ask|ask number|ask boolean)\\b"
        },
        {
          "name": "keyword.other.collection.said",
          "match": "\\b(create list|create object|create dictionary|empty list|remove|pick random from|random number between|split|join)\\b"
        },
        {
          "name": "keyword.other.file.said",
          "match": "\\b(write|read|append|fetch json|fetch url|fetch|file)\\b"
        }
      ]
    },
    "natural_operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.said",
          "match": "\\b(is greater than or equal to|is less than or equal to|is bigger than or equal to|is smaller than or equal to|is bigger than|is smaller than|is greater than|is less than|is elder than|is older than|is younger than|is not equal to|is not same as|is different from|is equal to|is same as|is exactly|is not|is|has)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.said",
          "match": "\\b(plus|minus|multiplied by|times|divided by|modulo|power of|and|or|not)\\b"
        },
        {
          "name": "keyword.operator.symbolic.said",
          "match": "(==|!=|<=|>=|<|>|\\+|-|\\*|/|%|\\*\\*|=)"
        }
      ]
    },
    "function_definition": {
      "match": "\\b(define|action|to)\\s+([a-zA-Z_]\\w*)",
      "captures": {
        "1": { "name": "keyword.declaration.function.said" },
        "2": { "name": "entity.name.function.said" }
      }
    },
    "function_calls": {
      "match": "\\b([a-zA-Z_]\\w*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.said" }
      }
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.said",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.said",
          "match": "\\b\\d+\\b"
        }
      ]
    }
  }
}
